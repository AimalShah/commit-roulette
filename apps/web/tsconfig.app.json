{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"],
      "@commit-roulette/shared": ["../../packages/shared/src/index.ts"],
      "@commit-roulette/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src"]
}
