# --- Clerk -----------------------------------------------------------------
# Clerk Dashboard → API Keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# --- Supabase --------------------------------------------------------------
# Supabase Dashboard → Project Settings → API
# NOTE: the publishable (anon) key is public by design. Every table is behind
# RLS — see supabase/migrations/0001_init.sql. Never put the service_role key
# in a VITE_ variable: Vite inlines VITE_* into the client bundle.
VITE_SUPABASE_URL=https://replace-me.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-me
