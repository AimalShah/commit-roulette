{
  "name": "@commit-roulette/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./scoring": "./src/scoring.ts",
    "./challenges": "./src/challenges/index.ts",
    "./join-code": "./src/join-code.ts",
    "./rng": "./src/rng.ts",
    "./format": "./src/format.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"shared: typecheck is the lint\" && tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "clean": "rm -rf .tsbuildinfo dist"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
