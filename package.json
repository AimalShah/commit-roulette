{
  "name": "commit-roulette",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @commit-roulette/web",
    "build": "npm run build --workspace @commit-roulette/web",
    "preview": "npm run preview --workspace @commit-roulette/web",
    "typecheck": "npm run typecheck --workspace @commit-roulette/web",
    "lint": "npm run lint --workspace @commit-roulette/web"
  }
}
